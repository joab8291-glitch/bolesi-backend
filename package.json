{
  "name": "bolesi-backend",
  "version": "1.0.0",
  "private": true,
  "description": "BOLESI commerce API and M-Pesa Daraja integration",
  "main": "src/server.js",
  "scripts": {
    "start": "if [ -n \"$DATABASE_URL\" ]; then npx prisma db push && node prisma/seed.js; fi; node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:deploy": "prisma db push"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.12",
    "prisma": "^6.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
